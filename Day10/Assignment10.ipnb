ne\n","import matplotlib.pyplot as plt\n","\n","# 2. Load the Pipeline\n","model_id = \"runwayml/stable-diffusion-v1-5\"\n","\n","# Check if CUDA is available, otherwise fallback to CPU\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","dtype = torch.float16 if torch.cuda.is_available() else torch.float32\n","\n","pipe = StableDiffusionPipeline.from_pretrained(\n","    model_id,\n","    torch_dtype=dtype,\n","    use_safetensors=True\n",")\n","pipe = pipe.to(device)\n","\n","# 3. Generate Images\n","# Using a prompt relevant to Stability AI's strengths\n","prompt = \"A high-tech laboratory with holographic displays, cyberpunk aesthetic, 8k resolution\"\n","image = pipe(prompt, num_inference_steps=25).images[0]\n","\n","# 4. Display\n","plt.imshow(image)\n","plt.axis(\"off\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":797,"referenced_widgets":["a5f3681f8752465fa656dae6c5beb01c","662847187d40483183119ba33f4ced0c","d0588f8d41d74df1b95a431eec157f70","fb4fc32c1cf542a698430a7c0bb2fa95","1b64f1e333db4608b7148674c1421215","1773ea7bb7bb433e9334415ec5e86bd8","edcd56276da14c27a2166ee8b9bea3c1","ece185b7a6594d02bbe713ec7760ff4c","0daeec7091c04581965825fa38612ebb","22a7520cb48042a1a99a297e4b6e0175","74625091c5fa47558316efd5d0564cac","b08824f1ab5e4d6296d848772b62bcf9","9b7ba7757b7a456b9933b91310158483","266950677e8842a69bbc6ae244a0cdb4","3d150f58f1a34ed6b577b4d4b803b3c4","b8350912b6cc4a91902d317074e481bd","00b565a9873c4051b2a56660dd6405f2","0c03062f56a24fa9982f0a527b531bce","7e5cf222720b4385883cf93f960d031a","d0d0abd618c943df9471c18801384d06","995e40679ef0466e9005a645aff164a1","a4518e791ffb4e31949bf88e37dd0902","b0b89b30a85440729e2ea06f34f162d1","46115768353e4994bd9c02c56ca45092","9480473adbaa4254a7de8d6c4eaf1dcc","1703ffcd616c4b878989d6766b9a751a","5293b9e95079471eb754ba6283218950","512d0d7f50f842f6bb9dcf7c6d1e97a7","94129ce4ed484de19f5b65d3b9d190b1","5694da16ad27409582a964403fc0f3eb","e403cb9b5afc4aabb9f5b90ef7808eba","b